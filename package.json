{
  "name": "alien-heist",
  "private": true,
  "version": "0.1.0",
  "description": "Alien Heist - twin-stick top-down shooter for mobile (GDD-driven prototype)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npx cap sync",
    "tunnel": "cloudflared tunnel run shy-bird-dev",
    "dev:remote": "vite & cloudflared tunnel run shy-bird-dev"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "@capacitor/haptics": "^6.0.3",
    "@capacitor/ios": "^6.2.1",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "playwright": "^1.62.1",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
